<a href="{{url}}" class="card" data-tags="{{#tags}}{{name}},{{/tags}}">
    <div class="card-img">
        {{#hasThumbnail}}
            <img src="{{thumbnail}}" alt="{{name}}">
        {{/hasThumbnail}}
        {{^hasThumbnail}}
            <span>{{name}}</span>
        {{/hasThumbnail}}
    </div>
    <div class="card-content">
        <h2 class="card-title">{{name}}</h2>
        <p class="card-desc">{{description}}</p>
        <div class="card-tags">
            {{#tags}}
                <span class="tag-pill">{{name}}</span>
            {{/tags}}
        </div>
    </div>
</a>
